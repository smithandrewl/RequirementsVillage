<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>893</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Domain/Project.fs" />
    <Compile Include="src/Infrastructure/Api/Types.fs" />
    <Compile Include="src/Infrastructure/Api/Codecs.fs" />
    <Compile Include="src/Infrastructure/Api/Projects.fs" />
    <Compile Include="src/Infrastructure/Storage/ThemeStorage.fs" />
    <Compile Include="src/Configuration/Constants.fs" />
    <Compile Include="src/Presentation/State/Types.fs" />
    <Compile Include="src/Presentation/State/Update.fs" />
    <Compile Include="src/Presentation/Components/Common.fs" />
    <Compile Include="src/Presentation/Components/ThemeSelector.fs" />
    <Compile Include="src/Presentation/Components/ProjectCard.fs" />
    <Compile Include="src/Presentation/Components/Layout.fs" />
    <Compile Include="src/Presentation/Pages/Landing.fs" />
    <Compile Include="src/Presentation/Pages/Dashboard.fs" />
    <Compile Include="src/App.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Fable.Elmish" Version="4.1.0" />
    <PackageReference Include="Fable.Elmish.React" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish.Debugger" Version="4.0.0" />
    <PackageReference Include="Fable.Elmish.HMR" Version="7.0.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.Bulma" Version="3.0.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Fable.Fetch" Version="2.6.0" />
    <PackageReference Include="Thoth.Json" Version="10.4.1" />
  </ItemGroup>
  
</Project>