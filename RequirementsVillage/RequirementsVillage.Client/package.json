{
  "name": "requirements-village-fsharp-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "dotnet fable watch . --run webpack serve",
    "build": "dotnet fable . && webpack",
    "test": "dotnet fable watch tests --run mocha tests-js --recursive --exit",
    "test:once": "dotnet fable tests && mocha tests-js --recursive --exit",
    "test:watch": "dotnet fable watch tests --run mocha tests-js --recursive --watch",
    "test:coverage": "dotnet fable tests && nyc --reporter=json --reporter=text --reporter=lcov mocha tests-js --recursive --exit",
    "coverage:report": "nyc report --reporter=html",
    "test:ci": "npm run test:coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "copy-webpack-plugin": "^13.0.0",
    "html-webpack-plugin": "^5.5.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "mocha": "^10.2.0",
    "jsdom": "^23.0.0",
    "jsdom-global": "^3.0.2",
    "nyc": "^15.1.0"
  },
  "nyc": {
    "include": [
      "src/**/*.js",
      "tests-js/**/*.js"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/fable_modules/**",
      "**/webpack.config.js",
      "**/tests/**",
      "**/*.config.js"
    ],
    "reporter": [
      "text",
      "html",
      "lcov",
      "json"
    ],
    "all": true,
    "report-dir": "../coverage/frontend",
    "temp-dir": "./.nyc_output",
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 80,
    "statements": 80
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
