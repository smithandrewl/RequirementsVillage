<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>893</NoWarn>
  </PropertyGroup>
  
  <!-- Test files -->
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  
  <!-- Dependencies -->
  <ItemGroup>
    <ProjectReference Include="../../RequirementsVillage.Shared/RequirementsVillage.Shared.fsproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </PackageReference>
    
    <!-- Testing packages -->
    <PackageReference Include="Fable.Mocha" Version="2.17.0" />
    
    <!-- Dependencies for tests -->
    <PackageReference Include="Fable.Elmish" Version="4.1.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Fable.Fetch" Version="2.6.0" />
    <PackageReference Include="Thoth.Json" Version="10.4.1" />
    <PackageReference Include="Bogus" Version="35.0.1" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.16.0" />
  </ItemGroup>
  
</Project>