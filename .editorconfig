# .editorconfig

root = true

# Default settings for all files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# F# files
[*.{fs,fsi,fsx}]
indent_style = space
indent_size = 2
end_of_line = lf

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx,json}]
indent_style = space
indent_size = 2
end_of_line = lf

# C# files (keeping existing settings)
[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
csharp_new_line_before_open_brace = none

# XML project files
[*.{csproj,fsproj,props,targets}]
indent_style = space
indent_size = 2
